# Xmake
.xmake/
build/
/dist/
/test-results/
# Generated resolver record contains absolute paths; committed dependency locks
# live in dependencies/, and CI uploads this per-run record as a diagnostic.
xmake-requires.lock

# IDE
.idea/
*.user
*.pro.user*

# C++ build artifacts
*.dll
*.dylib
*.so
*.exe
*.lib
*.a
*.exp
*.pdb
*.ilk

# Plugin binaries
plugins/**/*.dll
plugins/**/*.so
plugins/**/*.dylib

# Frontend plugin build outputs (locks stay tracked)
examples/plugins/*/dist/
examples/plugins/*/node_modules/
plugins/*/frontend/dist/
plugins/*/frontend/node_modules/
webui/packages/plugin-sdk/dist/
tests/types/node_modules/

# Python runtime cache
__pycache__/
*.pyc

# macOS
.DS_Store
*.app

# Linux
*.desktop~
*.AppImage

# Auto-generated resources
resources/app.ico
.archify
.tmp
install_file

# Runtime data
*.db
*.db-journal
*.db-wal
*.db-shm

# Logs
*.log
logs/

.claude/

.codegraph/
